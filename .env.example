# Apps Script web-app URL ending in /exec or /dev.
# Copy this file to .env.local (gitignored) and fill in the deployed URL.
VITE_API_URL=
# OAuth Web client ID (Google Cloud console -> Credentials -> OAuth 2.0 Client).
# Must list the app's origins (http://localhost:5173 for dev) as
# "Authorized JavaScript origins". NEVER commit the real .env.local.
VITE_GOOGLE_CLIENT_ID=
